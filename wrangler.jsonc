{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Keep the name "fusion": the planner's saved plans live in browser storage
  // for this origin (fusion.<subdomain>.workers.dev). Renaming changes the URL.
  "name": "fusion2",
  "main": "src/index.js",
  // Same runtime date and flag as the live deployment, so Worker behaviour is unchanged.
  "compatibility_date": "2025-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    // /pricing → /pricing/ ; unknown paths get 404.html (with a 404 status)
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Browser page loads that don't match a file are answered by the 404 page
    // without reaching the Worker — so the Worker's own routes must run first.
    "run_worker_first": ["/app/*", "/api/*", "/logout", "/healthz"]
  },
  // Accounts (proof of concept). Tables are created by the Worker on first use.
  "d1_databases": [
    { "binding": "DB", "database_name": "fusion2", "database_id": "495de0ab-896f-42af-8ab8-0088fdeb9d12" }
  ],
  "observability": { "enabled": true },
  // Branch previews (Cloudflare Worker Previews, built by `npx wrangler preview` on every push to a
  // branch other than main). Previews never inherit the settings above: no database and no
  // SESSION_SECRET, so accounts are off there (the planner falls back to access codes) and a
  // preview can never touch live accounts. Point a preview at a separate test database if needed.
  "previews": {}
}
